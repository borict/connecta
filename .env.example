# Copy this file to .env and fill in real values.

# Azure Service Bus (from namespace Shared access policies → Primary connection string)
AZURE_SERVICEBUS_CONNECTION_STRING=Endpoint=sb://YOUR_NAMESPACE.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=YOUR_KEY

# Topic / subscription names (must match Azure portal)
AZURE_SERVICEBUS_TOPIC=connecta-events
AZURE_SERVICEBUS_SUBSCRIPTION=notification-service

# Azure Blob Storage (profile pictures + post images)
# Connection string from Storage account → Access keys
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_AVATARS=avatars
AZURE_STORAGE_CONTAINER_POSTS=posts

# JWT (User Service issues; API Gateway validates) — use a long random secret in .env
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION_MS=86400000

# Local file storage when AZURE_STORAGE_CONNECTION_STRING is empty (profile pictures and post images)
CONNECTA_STORAGE_DIR=./uploads
# Use gateway port when clients go through API Gateway
CONNECTA_STORAGE_PUBLIC_BASE_URL=http://localhost:8080/media

# Zipkin / Eureka / Postgres below are for IntelliJ on the host.
# `docker compose --profile apps` overrides them inside containers:
#   ZIPKIN_ENDPOINT=http://zipkin:9411/api/v2/spans
#   EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://eureka:8761/eureka/
#   POSTGRES_HOST=postgres  POSTGRES_PORT=5432

# Zipkin (Docker Compose :9411). Sampling is 1.0 in application.yml for local demo.
ZIPKIN_ENDPOINT=http://localhost:9411/api/v2/spans

# Eureka (start eureka-server :8761 first; Gateway and Feign use service names)
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka/

# Postgres (Docker Compose host mapping 5433→5432)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=connecta
POSTGRES_PASSWORD=connecta
